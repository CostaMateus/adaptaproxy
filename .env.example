PORT=3000
API_KEY=your_proxy_api_key
HEADLESS=true
USER_DATA_DIR=./adapta_profiles
CHAT_SESSIONS_FILE=./adapta_profiles/chat-sessions.json
BROWSER=chromium

ADAPTA_DEFAULT_CHAT_ID=adaptaproxy-default-chat
ADAPTA_BASE_URL=https://agent.adapta.one
ADAPTA_CHAT_URL=https://agent.adapta.one/agentic-chat
ADAPTA_MODEL_ID=GPT_55
ADAPTA_PROJECT_NAME=PROXY

# Set to PERSONAL or CORPORATE
ADAPTA_ACCOUNT_MODE=PERSONAL

# PERSONAL
ADAPTA_EMAIL=
ADAPTA_PASSWORD=

# CORPORATE
ADAPTA_CREDENTIALS_SECRET=
CORPORATE_USERS_FILE=./adapta_profiles/users.json
CORPORATE_SESSIONS_DIR=./adapta_profiles/users
