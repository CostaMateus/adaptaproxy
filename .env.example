PORT=3000
HOST=127.0.0.1
PLAYWRIGHT_BROWSERS_PATH=C:/ProgramData/adaptaproxy/ms-playwright

# Structured application logs (one JSONL file per day).
APP_LOG_DIR=./logs
APP_LOG_LEVEL=info
APP_LOG_FILE=true
APP_LOG_CONSOLE=true

# Legacy fallback secret. User API keys are generated in /adaptaproxy/account.
API_KEY=
HEADLESS=true
USER_DATA_DIR=./adapta_profiles
CHAT_SESSIONS_FILE=./adapta_profiles/chat-sessions.json
BROWSER=chromium

ADAPTA_DEFAULT_CHAT_ID=adaptaproxy-default-chat
ADAPTA_BASE_URL=https://agent.adapta.one
ADAPTA_CHAT_URL=https://agent.adapta.one/agentic-chat
ADAPTA_MODEL_ID=GPT_55
ADAPTA_PROMPT_MODE=last_user
ADAPTA_PROJECT_NAME=PROXY

# Set a long random value before connecting Adapta accounts.
ADAPTA_CREDENTIALS_SECRET=change_me_to_a_long_random_secret

# PERSONAL is legacy. The web flow uses per-user accounts.
ADAPTA_ACCOUNT_MODE=PERSONAL

# PERSONAL
ADAPTA_EMAIL=
ADAPTA_PASSWORD=

# CORPORATE legacy storage
CORPORATE_USERS_FILE=./adapta_profiles/users.json
CORPORATE_SESSIONS_DIR=./adapta_profiles/users
